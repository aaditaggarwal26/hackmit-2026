// Copy to secrets.h and fill in. secrets.h is gitignored; never commit it.
#pragma once

// The ESP32-S3 radio is 2.4 GHz ONLY. A 5 GHz SSID is invisible to it, and the
// failure is indistinguishable from a wrong password -- the venue network
// HackMIT.2026 is 5 GHz-only (5660 MHz) and can never work here. The firmware
// prints a full 2.4 GHz scan on every failed attempt so this is visible.
//
// Beware the apostrophe: iOS names hotspots after the device, using U+2019
// ("Ritvik’s iPhone" = 52 69 74 76 69 6b e2 80 99 ...), not ASCII '. An ASCII
// quote here fails to associate and also looks like a bad password.
//
// Leave WIFI_PASSWORD as "" for an open network.
#define WIFI_SSID     "your-2.4GHz-ssid"
#define WIFI_PASSWORD "your-password-here"

// ---------------------------------------------------------------- control bus auth
//
// Sender pinning and the HMAC key (firmware/satellite_esp32/orbit_crypto.h; the ground's half
// is orbit/protocol/auth.py). Both have safe defaults in orbit_crypto.h, so a board flashed
// without this block still runs -- unauthenticated, which the bus log says plainly. They are
// NOT in orbit_config.h on purpose: that file is the one tools/check_firmware_sync.py holds
// against orbit/config.py field for field, and neither of these is a shared protocol fact --
// the ground's hostname is site-local and the key is a secret.

// The ONLY sender whose offers_open / grant / revoke / tx_ack this board will act on. Anything
// else claiming to be the ground is dropped before ArduinoJson ever sees it. This is whatever
// the ground box calls itself -- socket.gethostname().split(".")[0], unless ORBIT_HOSTNAME is
// set there -- and the ground must be started with ORBIT_GROUND_NAME set to the same string.
#define ORBIT_GROUND_NAME "gx10-f548"

// The pre-shared key, used as the RAW BYTES of this string literal: no hex step, no base64
// step, nothing the two languages could decode differently. The ground gets the identical
// characters in its environment:
//
//     ORBIT_AUTH_KEY='<the same string>' ORBIT_PIN_SENDERS=1 uv run orbit ground
//
// Generate one and paste the SAME output into both places (32 random bytes as 64 hex
// characters, used here as 64 ASCII characters of key material):
//
//     python3 -c "import secrets; print(secrets.token_hex(32))"
//
// It may not contain a NUL byte (it reaches the firmware as a C string and would be truncated
// there; orbit/protocol/auth.py rejects one rather than let the two sides disagree). Leave it
// "" to run the bus unauthenticated, which is the default and what the simulator uses.
//
// secrets.h is gitignored. NEVER commit a real key, and never paste one into a test fixture.
#define ORBIT_AUTH_KEY ""

// Payload confidentiality: the AES-GCM key as HEX (32/48/64 hex chars = AES-128/192/256-GCM).
// When set, the satellite seals the frame payload before it goes on the air; the ground decrypts
// with the SAME key in its environment:
//
//     ORBIT_PAYLOAD_KEY='<the same 64 hex chars>' uv run orbit ground
//
// Generate one and paste the SAME hex into both places:
//
//     python3 -c "import secrets; print(secrets.token_hex(32))"
//
// Leave it "" to send frames compressed-but-clear, which is the default and correct for this
// public MODIS corpus. Only the bulk frame payload is sealed; control/telemetry JSON stay
// readable. This is orthogonal to ORBIT_AUTH_KEY (integrity) -- a product sets both.
#define ORBIT_PAYLOAD_KEY ""

// The ground's Ed25519 PUBLIC key as 64 hex chars. When set, this board verifies that every
// grant/revoke/tx_ack carries a signature from the ground -- so even a holder of the shared
// ORBIT_AUTH_KEY cannot forge a command. Public, not secret, but site-local. Generate the pair
// on the ground and print the public half:
//
//     python3 -c "import os,base64; from orbit.protocol import ed25519; \
//       s=os.urandom(32); print('seed ', s.hex()); print('pubkey', ed25519.secret_to_public(s).hex())"
//
// Put `seed` in the ground's environment as ORBIT_GROUND_SIGN_KEY, and `pubkey` here (and in
// every board's secrets.h). Leave "" to skip the signature check (HMAC + pin still apply).
#define ORBIT_GROUND_PUBKEY ""
